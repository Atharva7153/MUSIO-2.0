{
  "name": "musio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'if [ -f MUSIO-2.0-yt-backend/index.js ] && ! lsof -i:4000 >/dev/null 2>&1; then (cd MUSIO-2.0-yt-backend && PORT=4000 node index.js) & fi; next dev --turbopack'",
    "build": "next build --turbopack",
    "start": "sh -c '(cd MUSIO-2.0-yt-backend && PORT=4000 node index.js) & exec npx next start -H 0.0.0.0 -p ${PORT:-3000}'"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.5",
    "@react-three/fiber": "^9.3.0",
    "cloudinary": "^2.7.0",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.542.0",
    "mongoos": "^0.0.1-security",
    "mongoose": "^8.18.0",
    "next": "^16.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4"
  }
}
